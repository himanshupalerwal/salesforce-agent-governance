        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>Agent1_Won</fullName>
                <default>false</default>
                <label>Agent 1 Won</label>
            </value>
            <value>
                <fullName>Agent2_Won</fullName>
                <default>false</default>
                <label>Agent 2 Won</label>
            </value>
            <value>
                <fullName>Queued</fullName>
                <default>false</default>
                <label>Queued</label>
            </value>
            <value>
                <fullName>Failed</fullName>
                <default>false</default>
                <label>Failed</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
