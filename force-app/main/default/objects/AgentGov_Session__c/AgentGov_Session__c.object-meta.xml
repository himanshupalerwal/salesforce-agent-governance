<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionOverrides>
        <actionName>Accept</actionName>
        <type>Default</type>
    </actionOverrides>
    <actionOverrides>
        <actionName>View</actionName>
        <comment>Opens the session's details with its action log, without an activity timeline.</comment>
        <content>AgentGov_Session_Record_Page</content>
        <formFactor>Large</formFactor>
        <skipRecordTypeSelect>false</skipRecordTypeSelect>
        <type>Flexipage</type>
    </actionOverrides>
    <compactLayoutAssignment>AgentGov_Session_Highlights</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>One run of an agent's governed activity, from its first governed action until it goes idle, reaches 24 hours, or is ended, with the run's usage and action count. Finished sessions are kept until the log retention period passes.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Agent Session</label>
    <nameField>
        <displayFormat>SES-{0000}</displayFormat>
        <label>Session Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Agent Sessions</pluralLabel>
    <searchLayouts>
        <customTabListAdditionalFields>Agent_Registration__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Status__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Session_Start__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Last_Activity__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>End_Reason__c</customTabListAdditionalFields>
        <customTabListAdditionalFields>Actions_Count__c</customTabListAdditionalFields>
        <lookupDialogsAdditionalFields>Agent_Registration__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Status__c</lookupDialogsAdditionalFields>
        <lookupDialogsAdditionalFields>Session_Start__c</lookupDialogsAdditionalFields>
        <searchResultsAdditionalFields>Agent_Registration__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Status__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Session_Start__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>ControlledByParent</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
