<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Duration_Minutes__c</fullName>
    <label>Duration (Minutes)</label>
    <type>Number</type>
    <precision>10</precision>
    <scale>1</scale>
    <formula>(BLANKVALUE(Session_End__c, Last_Activity__c) - Session_Start__c) * 1440</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <externalId>false</externalId>
    <description>Minutes from the start of the session to its end, or to its last activity while it is still running.</description>
    <trackTrending>false</trackTrending>
</CustomField>
