<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>AgentGov Usage History</masterLabel>
    <description>Daily budget usage for one agent, or for every agent when placed outside a record page.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="days" type="Integer" label="Days shown at first" default="7" min="1" max="90" />
        </targetConfig>
        <targetConfig targets="lightning__RecordPage">
            <property name="days" type="Integer" label="Days shown at first" default="7" min="1" max="90" />
            <objects>
                <object>AgentGov_Registration__c</object>
            </objects>
            <supportedFormFactors>
                <supportedFormFactor type="Large" />
                <supportedFormFactor type="Small" />
            </supportedFormFactors>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
