  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/himanshupalerwal/salesforce-agent-governance.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint force-app/main/default/lwc force-app/test",
    "prettier": "prettier --write \"**/*.{cls,trigger,apex,css,html,js,json,md,yml,yaml}\"",
    "prettier:verify": "prettier --check \"**/*.{cls,trigger,apex,css,html,js,json,md,yml,yaml}\"",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest",
    "test:unit:coverage": "sfdx-lwc-jest --coverage",
    "test:unit:watch": "sfdx-lwc-jest --watch"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@lwc/eslint-plugin-lwc": "^3.5.0",
    "@salesforce/eslint-config-lwc": "^4.1.2",
    "@salesforce/eslint-plugin-lightning": "^2.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.9.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.0",
    "prettier-plugin-apex": "^2.3.0"
  }
}
